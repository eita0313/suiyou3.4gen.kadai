mysql:
    image: mysql:8.0
    container_name: mysql
    environment:
      MYSQL_ROOT_PASSWORD: rootpassword  # ルートパスワード
      MYSQL_DATABASE: example_db         # 作成するデータベース名
      MYSQL_USER: dbuser                 # ユーザー名
      MYSQL_PASSWORD: dbpassword         # パスワード
    ports:
      - "3306:3306"

